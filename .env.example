# Deployment settings for docker compose.
# On the server:  cp .env.example .env   then edit the values below.
# docker compose reads this file automatically. Never commit the real .env.

# How Caddy serves the site.
#   hcm.example.com -> automatic HTTPS from Let's Encrypt.
#                      Needs an A record pointing at this server, and ports 80+443 open.
#   :80             -> plain HTTP. Use this first to test with the server's IP.
SITE_ADDRESS=hcm.example.com

# How people actually reach the site. Used for the backend's CORS allow-list.
PUBLIC_URL=https://hcm.example.com

# Database. Compose creates this Postgres for you; nothing to install.
POSTGRES_USER=hcm
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=hcm_lite

# Any long random string. Changing it signs everyone out.
# Generate one:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# AI assistant. Optional — without a key the app still runs and the assistant
# reports that it is unavailable instead of breaking.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
