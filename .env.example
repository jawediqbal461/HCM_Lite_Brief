# Deployment settings for docker compose.
# On the server:  cp .env.example .env   then edit the values below.
# docker compose reads this file automatically. Never commit the real .env.

# --- How the site is served -------------------------------------------------
#
# CASE A: this server is free (nothing else on ports 80/443).
#   Caddy takes those ports and gets HTTPS automatically. Leave HTTP_BIND and
#   HTTPS_BIND unset.
#     SITE_ADDRESS=hcm.example.com
#
# CASE B: this server ALREADY runs nginx/Apache for other sites.
#   Do NOT take 80/443 or you will knock those sites offline. Serve plain HTTP
#   on a local port and let the existing web server proxy to it; that web server
#   handles the certificate (see README section 4.2).
#     SITE_ADDRESS=:80
#     HTTP_BIND=127.0.0.1:8080
#     HTTPS_BIND=127.0.0.1:8443
#
SITE_ADDRESS=hcm.example.com
# HTTP_BIND=127.0.0.1:8080
# HTTPS_BIND=127.0.0.1:8443

# How people actually reach the site. Used for the backend's CORS allow-list.
PUBLIC_URL=https://hcm.example.com

# Database. Compose creates this Postgres for you; nothing to install.
POSTGRES_USER=hcm
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=hcm_lite

# Any long random string. Changing it signs everyone out.
# Generate one:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# AI assistant. Optional — without a key the app still runs and the assistant
# reports that it is unavailable instead of breaking.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
