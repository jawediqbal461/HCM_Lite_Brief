# Database
DATABASE_URL=postgresql+psycopg://hcm_user:hcm_pass@localhost:5432/hcm_lite

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First-run admin (optional; if unset, first-run setup wizard asks for it)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI assistant. The key is read here and never reaches the browser.
#
#   Anthropic:  AI_PROVIDER=anthropic  AI_MODEL=claude-sonnet-4-5
#   OpenAI:     AI_PROVIDER=openai     AI_MODEL=gpt-4o-mini
#   xAI / Grok: AI_PROVIDER=openai     AI_MODEL=grok-3     AI_BASE_URL=https://api.x.ai/v1
#
# Any OpenAI-compatible provider works the same way: set AI_PROVIDER=openai and
# point AI_BASE_URL at it. The assistant needs tool calling, so check the model
# you pick supports it.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_BASE_URL=

# CORS — comma-separated list of allowed frontend origins (no trailing slash).
# In production set this to your deployed frontend URL, e.g.
# FRONTEND_ORIGIN=https://hcm-lite.onrender.com,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
